    <!-- 引导 -->
    <string name="onboarding_title">三步完成配置</string>
    <string name="onboarding_step1">打开开发者选项</string>
    <string name="onboarding_step1_desc">设置 → 关于本机 → 版本信息，连点「版本号」7 次，按提示输入锁屏密码。</string>
    <string name="onboarding_step2">打开无线调试</string>
    <string name="onboarding_step2_desc">开发者选项 → 无线调试。若列表里没有，先确认开发者选项总开关已打开。</string>
    <string name="onboarding_step3">授予写设置权限</string>
    <string name="onboarding_step3_desc">两种方式任选其一：电脑执行 adb 命令，或在下方走本机配对。</string>
    <string name="onboarding_step4">确认就绪</string>
    <string name="onboarding_step4_desc">三项都显示「开」即可开始使用。</string>
    <string name="onboarding_open_dev">直达开发者选项</string>
    <string name="onboarding_open_wireless">直达无线调试</string>
    <string name="onboarding_copy">复制</string>
    <string name="onboarding_finish">完成</string>
    <string name="onboarding_later">稍后再说</string>
    <string name="onboarding_compat_title">ColorOS 找不到「禁止权限监控」？</string>
    <string name="onboarding_compat_body">ColorOS 16 起中文界面会隐藏该开关。把系统语言临时切换为 English，再进入开发者选项，接近底部找到 Disable system optimization（旧版为 Disable permission monitoring）并打开，选允许。完成后可以切回中文，已授予的权限不受影响。</string>
    <string name="onboarding_compat_locale">切换系统语言</string>
    <string name="onboarding_battery">把应用加入电池优化白名单，避免系统清理后台</string>
    <string name="onboarding_battery_on">已在电池优化白名单</string>

